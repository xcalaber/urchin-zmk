#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keymap_italian.h"

// Layer definitions

#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define ACCENT 5
#define SETTINGS 6

// -----------------

&sk {
    // don't release mods on other mods presses

    ignore-modifiers;
};

/ {
    behaviors {
        // Enables holding the first mod-tap key
        // by performing a tap-release-hold sequence.
        // To use it: "&qt KEYCODE1 KEYCODE2"

        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        Tab_Lay1: Tab_Lay1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAB_LAY1";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&mo 1>, <&tog 1>;
        };

        Del_Lay2: Del_Lay2 {
            compatible = "zmk,behavior-tap-dance";
            label = "DEL_LAY2";
            #binding-cells = <0>;
            bindings = <&kp DEL>, <&mo 2>, <&tog 2>;
        };

        Lay_Hold: Lay_Hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LAY_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        Key_Hold: Key_Hold {
            compatible = "zmk,behavior-hold-tap";
            label = "KEY_HOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            bindings = <&Shifted>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        kp_as_ht: keypress_to_autoshift {
            compatible = "zmk,behavior-hold-tap";
            label = "KEYPRESS_TO_AUTOSHIFT";
            bindings = <&as>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };
    };

    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.

        unstick: unstick {
            label = "ZM_unstick";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };

        Shifted: Shifted {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &macro_param_1to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SHIFTED";
        };

        as: as {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AS";
        };
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys
        // internal-left & external-right thumb keys
        // both left thumb keys
        // left index & middle fingers (home-row)
        // hold control & space for Adobe workflow

        No0 {
            bindings = <&as N0>;
            key-positions = <33 32>;
        };

        No1 {
            bindings = <&as NUMBER_1>;
            key-positions = <25 26>;
        };

        No2 {
            bindings = <&as NUMBER_2>;
            key-positions = <26 27>;
        };

        No3 {
            bindings = <&as NUMBER_3>;
            key-positions = <27 28>;
        };

        No4 {
            bindings = <&as NUMBER_4>;
            key-positions = <15 16>;
        };

        No5 {
            bindings = <&as N5>;
            key-positions = <16 17>;
        };

        No6 {
            bindings = <&as NUMBER_6>;
            key-positions = <17 18>;
        };

        No7 {
            bindings = <&as N7>;
            key-positions = <5 6>;
        };

        No8 {
            bindings = <&as N8>;
            key-positions = <6 7>;
        };

        No9 {
            bindings = <&as N9>;
            key-positions = <7 8>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <1 3>;
        };

        down {
            bindings = <&kp DOWN>;
            key-positions = <11 13>;
        };

        left {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <12 11>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <12 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        default_layer {
            label = "Base";
            bindings = <
&kp Q  &kp W           &kp E           &kp R             &kp T             &kp Y                  &kp U              &kp_as_ht I LEFT_BRACKET  &kp_as_ht O RIGHT_BRACKET  &kp P
&kp A  &qt S LEFT_GUI  &qt D LEFT_ALT  &qt F LEFT_SHIFT  &qt G LCTRL       &qt H RCTRL            &qt J RIGHT_SHIFT  &qt K RIGHT_ALT           &qt L RIGHT_GUI            &kp SEMI
&kp Z  &qt X HOME      &kp C           &qt V END         &kp B             &kp N                  &kp M              &kp COMMA                 &kp DOT                    &kp SLASH
                                       &mo 1             &qt LSHIFT SPACE  &qt ENTER RIGHT_SHIFT  &sl 2
            >;
        };

        // Numbers and high frequency symbols
        // Main modifiers and arrow keys
        // Function keys with modifiers
        // Low frequency symbols.
        // Used to type regional accents.
        // Used to change the keyboard's settings.

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };
    };
};
