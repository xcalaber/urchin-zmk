#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keymap_italian.h"

// Layer definitions

#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define ACCENT 5
#define SETTINGS 6

// -----------------

&sk {
    // don't release mods on other mods presses

    ignore-modifiers;
};

/ {
    behaviors {
        // Enables holding the first mod-tap key
        // by performing a tap-release-hold sequence.
        // To use it: "&qt KEYCODE1 KEYCODE2"

        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            bindings = <&shifted>, <&kp>;

            tapping-term-ms = <250>;
            flavor = "tap-preferred";
        };

        Tab_Layer1: Tab_Layer1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAB_LAYER1";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&mo 0>, <&to 0>;
        };

        Del_Lay2: Del_Lay2 {
            compatible = "zmk,behavior-tap-dance";
            label = "DEL_LAY2";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&mo 0>, <&to 0>;
        };

        Layer_Hold: Layer_Hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        Key_Hold: Key_Hold {
            compatible = "zmk,behavior-hold-tap";
            label = "KEY_HOLD";
            bindings = <&kp>, <&as>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };
    };

    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.

        unstick: unstick {
            label = "ZM_unstick";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };

        shifted: shifted {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SHIFTED";
        };

        as: as {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AS";
        };
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys
        // internal-left & external-right thumb keys
        // both left thumb keys
        // left index & middle fingers (home-row)
        // hold control & space for Adobe workflow

        No1 {
            bindings = <&as NUMBER_1>;
            key-positions = <25 26>;
        };

        No2 {
            bindings = <&as NUMBER_2>;
            key-positions = <27 26>;
        };

        No3 {
            bindings = <&as NUMBER_3>;
            key-positions = <27 28>;
        };

        No4 {
            bindings = <&as NUMBER_4>;
            key-positions = <15 16>;
        };

        No5 {
            bindings = <&as N5>;
            key-positions = <16 17>;
        };

        No6 {
            bindings = <&as NUMBER_6>;
            key-positions = <17 18>;
        };

        No7 {
            bindings = <&as N7>;
            key-positions = <5 6>;
        };

        No8 {
            bindings = <&as N8>;
            key-positions = <6 7>;
        };

        No9 {
            bindings = <&as N9>;
            key-positions = <7 8>;
        };

        No0 {
            bindings = <&as N0>;
            key-positions = <32 33>;
        };

        Backspace {
            bindings = <&kp K_BACK>;
            key-positions = <8 9>;
        };

        Up {
            bindings = <&kp UP_ARROW>;
            key-positions = <1 3>;
        };

        Down {
            bindings = <&kp DOWN>;
            key-positions = <11 13>;
        };

        Left {
            bindings = <&kp LEFT>;
            key-positions = <12 10>;
        };

        Right {
            bindings = <&kp RIGHT>;
            key-positions = <12 14>;
        };

        Dash {
            bindings = <&as MINUS>;
            key-positions = <18 19>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <22 21>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <23 22>;
        };

        All {
            bindings = <&kp LC(A)>;
            key-positions = <10 11>;
        };

        Paste_Clip {
            bindings = <&kp LG(V)>;
            key-positions = <24 23>;
        };

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <21 20>;
        };

        Lock {
            bindings = <&kp RG(L)>;
            key-positions = <29 19>;
        };

        PG-UP {
            bindings = <&kp PG_UP>;
            key-positions = <4 2>;
        };

        PG-DW {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <24 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        Base {
            label = "Base";
            bindings = <
&kp Q  &kp W           &kp E           &kp R             &kp T                &kp Y                &kp U              &Key_Hold I LEFT_BRACKET  &Key_Hold O RIGHT_BRACKET  &kp P
&kp A  &qt S LEFT_GUI  &qt D LEFT_ALT  &qt F LEFT_SHIFT  &qt G LCTRL          &qt H RCTRL          &qt J RIGHT_SHIFT  &qt K RIGHT_ALT           &qt L RIGHT_GUI            &as SEMI
&kp Z  &qt X HOME      &kp C           &qt V END         &kp B                &kp N                &kp M              &as COMMA                 &as DOT                    &as SLASH
                                       &Tab_Layer1       &Layer_Hold 2 SPACE  &Layer_Hold 1 ENTER  &Del_Lay2
            >;
        };

        // Numbers and high frequency symbols
        // Main modifiers and arrow keys
        // Function keys with modifiers
        // Low frequency symbols.
        // Used to type regional accents.
        // Used to change the keyboard's settings.

        Alt {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        Config {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 3  &trans  &trans  &bootloader
&trans       &trans  &trans  &trans  &trans  &bt BT_SEL 1  &bt BT_SEL 4  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &bt BT_SEL 2  &trans        &trans  &trans  &bt BT_CLR_ALL
                             &trans  &trans  &trans        &trans
            >;
        };

        Layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        Layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        Layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };
    };
};
